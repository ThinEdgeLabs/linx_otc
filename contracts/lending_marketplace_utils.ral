const PRECISION_DECIMALS = 18

Abstract Contract LendingMarketplaceUtils() {

  const Day = 86400

  pub fn blockTimeStampInSeconds() -> U256 {
    return (blockTimeStamp!() / 1000) % (1 << 32)
  }

  pub fn calculateInterestPayment(currentBlockTimeStamp: U256, loanTimestamp: U256, amount: U256, interest: U256, days: U256) -> U256 {
    let timeElapsed = currentBlockTimeStamp - loanTimestamp
    let totalInterest = amount * interest / 10000
    return totalInterest * timeElapsed / (Day * days)
  }

  pub fn calculateTotalInterestPayment(amount: U256, interest: U256, days: U256) -> U256 {
    return calculateInterestPayment(days * Day, 0, amount, interest, days)
  }

  pub fn calculateMarketplaceFee(amount: U256, feeRateValue: U256) -> U256 {
    return amount * feeRateValue / 10000
  }

  pub fn normalizeAmount(amount: U256, decimals: U256) -> U256 {
    if (decimals > PRECISION_DECIMALS) {
      return amount / (10 ** (decimals - PRECISION_DECIMALS))
    } else if (decimals < PRECISION_DECIMALS) {
      return amount * (10 ** (PRECISION_DECIMALS - decimals))
    } else {
      return amount
    }
  }

  @using(checkExternalCaller = false)
  pub fn calculateLTV(
    collateralTokenAmount: U256,
    collateralTokenPrice: TokenPrice,
    borrowedTokenAmount: U256,
    borrowedTokenPrice: TokenPrice
  ) -> U256 {
    let collateralPrice = normalizeAmount(collateralTokenPrice.price, collateralTokenPrice.decimals)
    let borrowedPrice = normalizeAmount(borrowedTokenPrice.price, borrowedTokenPrice.decimals)
    let collateralValue = collateralTokenAmount * collateralPrice
    let borrowedValue = borrowedTokenAmount * borrowedPrice

    return collateralValue * 10 ** PRECISION_DECIMALS / borrowedValue
  }

  // Calculate the amount of collateral to liquidate and pay back to reach the target LTV
  // L - loan value, C - collateral value, F - liquidation fee, T - target LTV, X - liquidation amount
  // LTV = L / C
  // L' = L - X New loan value after liquidation
  // C' = C - X - X * F New collateral value after liquidation
  // T = L' / C' = (L - X) / (C - X - X * F)
  // We solve for X:
  // X = (L - T * C) / (1 - T * (1 + F))
  pub fn calculateLiquidationAmount(collateralValue: U256, loanValue: U256, liquidationFee: U256, ltvTarget: U256) -> U256 {
    let precision = 10 ** PRECISION_DECIMALS
    let basisPoints = 10000

    // If the LTV is already healthy, return 0
    // LTV >= L / C
    // LTV * C >= L
    // L <= LTV * C
    if (loanValue * basisPoints <= ltvTarget * collateralValue / precision) {
      return 0
    }

    // Calculate denominator: (L - T * C)
    let denominator = loanValue - ltvTarget * collateralValue / precision / basisPoints

    // Calculate numerator: (1 - T * (1 + F)
    let numerator = 1 * precision - ltvTarget * (basisPoints * precision + liquidationFee) / precision / basisPoints / basisPoints

    // Calculate X
    let liquidationAmount = denominator * precision / numerator

    if (liquidationAmount > collateralValue) {
      return collateralValue
    } else {
      return liquidationAmount
    }
  }
}
