Contract LendingMarketplace(
  loanTemplateId: ByteVec,    // Contract ID of the loan template
  oracleContractId: ByteVec,  // Contract ID of the oracle contract
  liquidationFee: U256,       // Liquidation fee, in basis points
  mut borrowingFee: U256,     // Fee rate for borrowing, in basis points
  mut totalLoans: U256,       // Total number of loans created
  mut lendingEnabled: Bool,   // Flag to enable or disable lending
  upgradeDelay: U256,
  mut owner: Address,
  mut newOwner: Address,
  mut upgradeInitiated: U256,
  mut newCode: ByteVec,
  mut newImmFieldsEncoded: ByteVec,
  mut newMutFieldsEncoded: ByteVec
) extends LendingMarketplaceUtils(), Upgradable(upgradeDelay, owner, newOwner, upgradeInitiated, newCode, newImmFieldsEncoded, newMutFieldsEncoded) {

  // Mapping to store tokens that we collect fees in
  mapping[ByteVec, Bool] feeTokens

  event LoanCreated(loanId: ByteVec, id: U256, by: Address, timestamp: U256)
  event LoanDetails(loanId: ByteVec, lendingTokenId: ByteVec, collateralTokenId: ByteVec, lendingAmount: U256, collateralAmount: U256, interestRate: U256, duration: U256, lender: Address)
  event LoanCancelled(loanId: ByteVec, by: Address, timestamp: U256)
  event LoanPaid(loanId: ByteVec, by: Address, timestamp: U256)
  event LoanAccepted(loanId: ByteVec, by: Address, timestamp: U256)
  event LoanLiquidated(loanId: ByteVec, by: Address, timestamp: U256)
  event LoanPartiallyLiquidated(loanId: ByteVec, by: Address, timestamp: U256)
  event CollateralClaimed(loanId: ByteVec, by: Address, timestamp: U256)

  enum ErrorCodes {
    LendingDisabled = 0
    LenderAllowedOnly = 1
    BorrowerAllowedOnly = 2
    LenderNotAllowed = 3
    InvalidLendingAmount = 4
    InvalidCollateralAmount = 5
    InvalidInterestRate = 6
    InvalidDuration = 7
    LoanNotActive = 8
    LoanNotOverdue = 9
    LoanIsHealthy = 10
    LoanNotLiquidatable = 11
  }

  pub fn getTotalLoans() -> U256 { return totalLoans }
  pub fn getBorrowingFee() -> U256 { return borrowingFee }
  pub fn getLiquidationFee() -> U256 { return liquidationFee }
  pub fn isFeeToken(tokenId: ByteVec) -> Bool { return feeTokens.contains!(tokenId) }
  pub fn getOracleContractId() -> ByteVec { return oracleContractId }

  @using(preapprovedAssets = true, checkExternalCaller = false, updateFields = true)
  pub fn createLoan(lendingTokenId: ByteVec, collateralTokenId: ByteVec, lendingAmount: U256, collateralAmount: U256, interestRate: U256, duration: U256, canBeLiquidated: Bool) -> (Address) {
    assert!(lendingEnabled == true, ErrorCodes.LendingDisabled)
    assert!(lendingAmount > 0, ErrorCodes.InvalidLendingAmount)
    assert!(collateralAmount > 0, ErrorCodes.InvalidCollateralAmount)
    assert!(interestRate > 0, ErrorCodes.InvalidInterestRate)
    assert!(duration > 0, ErrorCodes.InvalidDuration)

    // If canBeLiquidated is true, check if oracle data is available for both tokens
    if (canBeLiquidated == true) {
      let _ = OracleWrapper(oracleContractId).getTokenPrice(lendingTokenId)
      let _ = OracleWrapper(oracleContractId).getTokenPrice(collateralTokenId)
    }

    // Checking for overflow
    let _ = calculateTotalInterestPayment(lendingAmount, interestRate, duration)

    let lender = callerAddress!()
    let id = totalLoans
    // TODO: This value should vary depending on the collateral
    // e.g. max LTV for wBTC is greater than max LTV for ALPH
    let maximumLTV = 8000 // 80%
    let (encodeImmutableFields, encodeMutableFields) = Loan.encodeFields!(
      id,
      lender,
      lendingTokenId,
      collateralTokenId,
      selfContractId!(),
      lendingAmount,
      collateralAmount,
      interestRate,
      duration,
      canBeLiquidated,
      maximumLTV,
      nullContractAddress!(),
      0
    )
    let loanId = copyCreateSubContract!{lender -> ALPH: minimalContractDeposit!(), lendingTokenId: lendingAmount}(
      toByteVec!(totalLoans), loanTemplateId, encodeImmutableFields, encodeMutableFields
    )
    totalLoans = totalLoans + 1

    emit LoanDetails(loanId, lendingTokenId, collateralTokenId, lendingAmount, collateralAmount, interestRate, duration, lender)
    emit LoanCreated(loanId, id, lender, blockTimeStamp!())

    return contractIdToAddress!(loanId)
  }

  @using(preapprovedAssets = true)
  pub fn borrow(loanId: ByteVec) -> () {
    let loan = Loan(loanId)
    let caller = callerAddress!()
    let lender = loan.getLender()
    checkCaller!(caller != lender, ErrorCodes.LenderNotAllowed)

    let collateralTokenId = loan.getCollateralTokenId()
    let collateralAmount = loan.getCollateralAmount()
    loan.borrow{caller -> collateralTokenId: collateralAmount}(caller)

    emit LoanAccepted(loanId, caller, blockTimeStamp!())
  }

  pub fn cancelLoan(loanId: ByteVec) -> () {
    let loan = Loan(loanId)
    let lender = loan.getLender()

    checkCaller!(callerAddress!() == lender, ErrorCodes.LenderAllowedOnly)

    loan.cancel()

    emit LoanCancelled(loanId, callerAddress!(), blockTimeStamp!())
  }

  @using(preapprovedAssets = true)
  pub fn repayLoan(loanId: ByteVec) -> () {
    let loan = Loan(loanId)
    let borrower = loan.getBorrower()
    let lendingTokenId = loan.getLendingTokenId()
    let loanAmount = loan.getLendingAmount()
    let interest = loan.getInterest()
    let caller = callerAddress!()

    checkCaller!(caller == borrower, ErrorCodes.BorrowerAllowedOnly)

    loan.repay{caller -> lendingTokenId: loanAmount + interest}()

    emit LoanPaid(loanId, caller, blockTimeStamp!())
  }

  pub fn claimCollateral(loanId: ByteVec) -> () {
    let loan = Loan(loanId)
    let lender = loan.getLender()

    checkCaller!(callerAddress!() == lender, ErrorCodes.LenderAllowedOnly)
    assert!(loan.isActive() == true, ErrorCodes.LoanNotActive)
    assert!(blockTimeStamp!() > loan.getLoanTimeStamp() + loan.getDuration() * Day * 1000, ErrorCodes.LoanNotOverdue)

    loan.claimCollateral()

    emit CollateralClaimed(loanId, lender, blockTimeStamp!())
  }

  @using(preapprovedAssets = true, checkExternalCaller = false)
  pub fn liquidateLoan(loanId: ByteVec) -> () {
    let caller = callerAddress!()
    let loan = Loan(loanId)

    assert!(loan.isActive() == true, ErrorCodes.LoanNotActive)
    assert!(loan.getCanBeLiquidated() == true, ErrorCodes.LoanNotLiquidatable)

    let lendingTokenId = loan.getLendingTokenId()
    let collateralTokenId = loan.getCollateralTokenId()
    let collateralAmount = loan.getCollateralAmount()
    let lendingAmount = loan.getLendingAmount()
    let interestAmount = loan.getInterest()
    let maxLTV = loan.getMaximumLTV()

    let collateralTokenPrice = OracleWrapper(oracleContractId).getTokenPrice(collateralTokenId)
    let borrowedTokenPrice = OracleWrapper(oracleContractId).getTokenPrice(lendingTokenId)

    let ltv = calculateLTV(collateralAmount, collateralTokenPrice, lendingAmount + interestAmount, borrowedTokenPrice)
    assert!(ltv > maxLTV, ErrorCodes.LoanIsHealthy)

    let collateralPrice = normalizeAmount(collateralTokenPrice.price, collateralTokenPrice.decimals)
    let borrowedPrice = normalizeAmount(borrowedTokenPrice.price, borrowedTokenPrice.decimals)

    let collateralValue = collateralAmount * collateralPrice / 10 ** PRECISION_DECIMALS
    let loanValue = (lendingAmount + interestAmount) * borrowedPrice / 10 ** PRECISION_DECIMALS

    // In usd
    let liquidationAmount = calculateLiquidationAmount(collateralValue, loanValue, liquidationFee, maxLTV)
    assert!(liquidationAmount > 0, ErrorCodes.LoanIsHealthy)

    let mut collateralToLiquidate = 0
    let mut amountToRepay = 0
    let mut liquidatorFee = 0

    // Partial liquidation
    if (liquidationAmount < collateralValue) {
      amountToRepay = liquidationAmount * 10 ** PRECISION_DECIMALS / normalizeAmount(borrowedTokenPrice.price, borrowedTokenPrice.decimals)
      liquidatorFee = liquidationAmount * liquidationFee / 10000
      // Add the liquidator fee to the liquidation amount
      collateralToLiquidate = (liquidationAmount + liquidatorFee) * 10 ** PRECISION_DECIMALS / normalizeAmount(collateralTokenPrice.price, collateralTokenPrice.decimals)
      emit LoanPartiallyLiquidated(loanId, caller, blockTimeStamp!())
    } else {
      // Full liquidation
      collateralToLiquidate = collateralAmount
      // Since the liquidator fee is not already included in the liquidation amount,
      // we need to subtract it from the amount to repay
      liquidatorFee = collateralValue * liquidationFee / 10000
      amountToRepay = (collateralValue - liquidatorFee) * 10 ** PRECISION_DECIMALS / normalizeAmount(borrowedTokenPrice.price, borrowedTokenPrice.decimals)
      emit LoanLiquidated(loanId, caller, blockTimeStamp!())
    }

    loan.liquidate{ caller -> lendingTokenId: amountToRepay, ALPH: dustAmount!() }(caller, amountToRepay, collateralToLiquidate)
  }

  //////////////////////////
  // Owner functions ///////
  //////////////////////////

  @using(updateFields = true)
  pub fn updateBorrowingFee(newFee: U256) -> () {
    assertOnlyOwner(callerAddress!())

    borrowingFee = newFee
  }

  @using(updateFields = true)
  pub fn pauseLending() -> () {
    assertOnlyOwner(callerAddress!())
    lendingEnabled = false
  }

  @using(updateFields = true)
  pub fn enableLending() -> () {
    assertOnlyOwner(callerAddress!())
    lendingEnabled = true
  }

  @using(assetsInContract = true, preapprovedAssets = true)
  pub fn withdraw(to: Address, tokenId: ByteVec, amount: U256) -> () {
    assertOnlyOwner(callerAddress!())

    if (callerAddress!() != to) {
      transferToken!(callerAddress!(), to, ALPH, dustAmount!())
    }

    transferTokenFromSelf!(to, tokenId, amount)
  }

  @using(payToContractOnly = true, preapprovedAssets = true, checkExternalCaller = false)
  pub fn deposit(tokenId: ByteVec, amount: U256) -> () {
    transferTokenToSelf!(callerAddress!(), tokenId, amount)
  }

  @using(preapprovedAssets = true)
  pub fn addFeeToken(tokenId: ByteVec) -> () {
    assertOnlyOwner(callerAddress!())
    feeTokens.insert!(callerAddress!(), tokenId, true)
  }

  pub fn removeFeeToken(tokenId: ByteVec) -> () {
    assertOnlyOwner(callerAddress!())
    feeTokens.remove!(callerAddress!(), tokenId)
  }
}
